# Optional. Without these the game uses the shared bgameworld Supabase
# project, whose URL and publishable key are built in (src/lib/supabase.ts).
# To point it at another project, copy this file to .env.local and fill it in
# (Project Settings → API). The key is safe to expose client-side — data is
# locked down by Row Level Security and the doodlezy_* functions.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
